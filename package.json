{
  "name": "portfolioweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "preview": "vite preview",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "test:perf": "pnpm build && lhci autorun",
    "cv:generate": "node --experimental-strip-types scripts/generate-cv.ts",
    "cv:pdf": "sh scripts/export-cv-pdf.sh",
    "cv:check": "sh scripts/check-cv-sync.sh",
    "cv": "pnpm cv:generate && pnpm cv:pdf",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "mui-markdown": "^2.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "lightningcss-darwin-arm64": "^1.32.0",
    "prettier": "^3.8.2",
    "typescript": "~6.0.2",
    "vesely-dev-config": "git+https://github.com/Veselyy/vesely-dev-config.git",
    "vite": "^7.3.6"
  }
}
